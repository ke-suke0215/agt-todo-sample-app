{
  "name": "agt-todo-sample-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test e2e/api.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@openai/agents": "^0.22.0",
    "eventsource-parser": "^4.1.3",
    "hono": "^4.13.21",
    "lucide-react": "^1.78.0",
    "openai": "^7.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
